generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                  String            @db.VarChar(255)
  slug                  String            @unique @db.VarChar(100)
  organizationType      OrganizationType? @default(CLINIC) @map("organizationType")
  phone_number          String?           @db.VarChar(20)
  email                 String?           @db.VarChar(255)
  address               String?
  google_sheets_id      String?           @db.VarChar(255)
  whatsapp_phone_number String?           @db.VarChar(20)
  whatsappBusinessId    String?           @map("whatsappBusinessId")
  whatsapp_api_token    String?
  whatsapp_credentials  Json?
  timezone              String?           @default("UTC") @db.VarChar(50)
  language              String?           @default("en") @db.VarChar(10)
  subscription_tier     String?           @default("basic") @db.VarChar(50)
  subscription_status   String?           @default("TRIAL")
  subscription_plan     String?           @default("BASIC")
  subscriptionEndsAt    DateTime?         @map("subscriptionEndsAt")
  doctorCount           Int?              @default(1) @map("doctorCount")
  maxPatients           Int?              @map("maxPatients")
  maxAppointments       Int?              @map("maxAppointments")
  subscriptionType      String?           @map("subscriptionType")
  lastBilledAt          DateTime?         @map("lastBilledAt")
  nextBillingDate       DateTime?         @map("nextBillingDate")
  paymentMethod         String?           @map("paymentMethod")
  region                String?           @default("PAKISTAN") @map("region")
  whatsappWebhookUrl    String?           @map("whatsappWebhookUrl")
  googleSheetsStructure String?           @default("TABS") @map("googleSheetsStructure")
  is_active             Boolean?          @default(true)
  created_at            DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?         @default(now()) @db.Timestamptz(6)
  appointments          Appointment[]
  audit_logs            AuditLog[]
  message_templates     MessageTemplate[]
  patients              Patient[]
  providers             Provider[]
  system_config         SystemConfig[]
  users                 User[]
  whatsapp_messages     WhatsAppMessage[]

  @@index([slug], map: "idx_organizations_slug")
  @@map("organizations")
}

model User {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String       @db.Uuid
  email           String       @unique @db.VarChar(255)
  password_hash   String       @db.VarChar(255)
  first_name      String       @db.VarChar(100)
  last_name       String       @db.VarChar(100)
  phone_number    String?      @db.VarChar(20)
  role            UserRole     @default(STAFF)
  specialization  String?      @db.VarChar(255)
  license_number  String?      @db.VarChar(100)
  is_active       Boolean?     @default(true)
  last_login_at   DateTime?    @db.Timestamptz(6)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)
  password        String?
  phone           String?
  audit_logs      AuditLog[]
  providers       Provider[]
  organizations   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_users_email")
  @@index([organization_id], map: "idx_users_organization_id")
  @@map("users")
}

model Provider {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id  String           @db.Uuid
  user_id          String?          @db.Uuid
  name             String           @db.VarChar(255)
  specialization   String?          @db.VarChar(255)
  qualification    String?          @db.VarChar(500)
  experience_years Int?
  consultation_fee Decimal?         @db.Decimal(10, 2)
  phone_number     String?          @db.VarChar(20)
  email            String?          @db.VarChar(255)
  working_hours    Json?
  is_available     Boolean?         @default(true)
  status           provider_status? @default(active)
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?        @default(now()) @db.Timestamptz(6)
  appointments     Appointment[]
  organizations    Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            User?            @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([organization_id], map: "idx_providers_organization_id")
  @@map("providers")
}

model Patient {
  id                      String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id         String            @db.Uuid
  external_id             String?           @db.VarChar(255)
  first_name              String            @db.VarChar(100)
  last_name               String            @db.VarChar(100)
  phone_number            String            @db.VarChar(20)
  email                   String?           @db.VarChar(255)
  date_of_birth           DateTime?         @db.Date
  gender                  String?           @db.VarChar(10)
  address                 String?
  medical_history         String?
  emergency_contact_name  String?           @db.VarChar(255)
  emergency_contact_phone String?           @db.VarChar(20)
  language                String?           @default("en") @db.VarChar(10)
  whatsapp_opted_in       Boolean?          @default(true)
  last_synced_at          DateTime?         @db.Timestamptz(6)
  created_at              DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?         @default(now()) @db.Timestamptz(6)
  appointments            Appointment[]
  organizations           Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  whatsapp_messages       WhatsAppMessage[]

  @@unique([organization_id, phone_number])
  @@index([organization_id], map: "idx_patients_organization_id")
  @@index([organization_id, phone_number], map: "idx_patients_phone")
  @@map("patients")
}

model Appointment {
  id                   String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id      String              @db.Uuid
  external_id          String?             @db.VarChar(255)
  patient_id           String              @db.Uuid
  provider_id          String              @db.Uuid
  appointment_date     DateTime            @db.Date
  appointment_time     DateTime            @db.Time(6)
  duration_minutes     Int?                @default(30)
  status               appointment_status? @default(scheduled)
  reason_for_visit     String?
  notes                String?
  consultation_fee     Decimal?            @db.Decimal(10, 2)
  whatsapp_message_id  String?             @db.VarChar(255)
  reminder_sent        Boolean?            @default(false)
  reminder_sent_at     DateTime?           @db.Timestamptz(6)
  confirmation_sent    Boolean?            @default(false)
  confirmation_sent_at DateTime?           @db.Timestamptz(6)
  follow_up_sent       Boolean?            @default(false)
  follow_up_sent_at    DateTime?           @db.Timestamptz(6)
  last_synced_at       DateTime?           @db.Timestamptz(6)
  created_at           DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?           @default(now()) @db.Timestamptz(6)
  organizations        Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patients             Patient             @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  providers            Provider            @relation(fields: [provider_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  whatsapp_messages    WhatsAppMessage[]

  @@unique([organization_id, external_id])
  @@index([organization_id, appointment_date], map: "idx_appointments_date")
  @@index([organization_id], map: "idx_appointments_organization_id")
  @@index([patient_id], map: "idx_appointments_patient")
  @@index([provider_id], map: "idx_appointments_provider")
  @@map("appointments")
}

model WhatsAppMessage {
  id                  String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id     String       @db.Uuid
  patient_id          String?      @db.Uuid
  appointment_id      String?      @db.Uuid
  whatsapp_message_id String?      @db.VarChar(255)
  phone_number        String       @db.VarChar(20)
  message_type        message_type
  message_content     String
  template_name       String?      @db.VarChar(255)
  is_incoming         Boolean?     @default(false)
  delivery_status     String?      @default("pending") @db.VarChar(50)
  delivered_at        DateTime?    @db.Timestamptz(6)
  read_at             DateTime?    @db.Timestamptz(6)
  error_message       String?
  created_at          DateTime?    @default(now()) @db.Timestamptz(6)
  appointments        Appointment? @relation(fields: [appointment_id], references: [id], onUpdate: NoAction)
  organizations       Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patients            Patient?     @relation(fields: [patient_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_whatsapp_messages_created_at")
  @@index([organization_id], map: "idx_whatsapp_messages_organization_id")
  @@index([phone_number], map: "idx_whatsapp_messages_phone")
  @@map("whatsapp_messages")
}

model MessageTemplate {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String       @db.Uuid
  name            String       @db.VarChar(255)
  type            message_type
  language        String?      @default("en") @db.VarChar(10)
  subject         String?      @db.VarChar(255)
  content         String
  variables       Json?
  is_active       Boolean?     @default(true)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)
  organizations   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name, language])
  @@map("message_templates")
}

model AuditLog {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String?       @db.Uuid
  user_id         String?       @db.Uuid
  table_name      String        @db.VarChar(255)
  record_id       String?       @db.Uuid
  action          String        @db.VarChar(50)
  old_values      Json?
  new_values      Json?
  timestamp       DateTime?     @default(now()) @db.Timestamptz(6)
  ip_address      String?       @db.Inet
  user_agent      String?
  organizations   Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           User?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([organization_id], map: "idx_audit_logs_organization_id")
  @@index([timestamp], map: "idx_audit_logs_timestamp")
  @@map("audit_logs")
}

model SystemConfig {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String?       @db.Uuid
  config_key      String        @db.VarChar(255)
  config_value    String?
  config_type     String?       @default("string") @db.VarChar(50)
  description     String?
  is_encrypted    Boolean?      @default(false)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)
  organizations   Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, config_key])
  @@map("system_config")
}

enum appointment_status {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum message_type {
  appointment_confirmation
  reminder
  follow_up
  custom
}

enum provider_status {
  active
  inactive
  on_leave
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  DOCTOR
  STAFF
  PROVIDER

  @@map("user_role")
}

enum OrganizationType {
  CLINIC
  DOCTOR
  HOSPITAL
  SPECIALIST
  PHARMACY
  DIAGNOSTIC

  @@map("OrganizationType")
}

model TrialHistory {
  id               String    @id @default(cuid())
  phoneNumber      String    @unique
  email            String
  organizationName String
  phoneVerified    Boolean   @default(false)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([organizationName])
  @@map("trial_history")
}

model BillingHistory {
  id              String   @id @default(cuid())
  organizationId  String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String
  paymentMethod   String
  paymentStatus   String
  transactionId   String?
  billingPeriod   String
  doctorCount     Int
  createdAt       DateTime @default(now())

  @@index([organizationId, billingPeriod])
  @@map("billing_history")
}
