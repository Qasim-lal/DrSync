generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                         String                @id @default(cuid())
  name                       String
  slug                       String                @unique
  organizationType           OrganizationType?     @default(CLINIC)
  phone                      String?
  email                      String?
  address                    String?
  website                    String?
  subscriptionPlan           SubscriptionPlan      @default(FREE)
  subscriptionStatus         SubscriptionStatus    @default(TRIAL)
  subscriptionEndsAt         DateTime?
  googleSheetsId             String?
  googleCredentials          Json?
  whatsappPhoneNumber        String?
  whatsappBusinessId         String?
  whatsappCredentials        Json?
  timezone                   String?               @default("UTC")
  language                   String?               @default("en")
  isActive                   Boolean               @default(true)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  doctorCount                Int?                  @default(1)
  googleSheetsStructure      String?               @default("TABS")
  lastBilledAt               DateTime?
  nextBillingDate            DateTime?
  paymentMethod              String?
  region                     String?               @default("PAKISTAN")
  subscriptionType           String?
  whatsappWebhookUrl         String?
  maxAppointments            Int?
  maxPatients                Int?
  googleSheetsSyncEnabled    Boolean?
  googleSheetsSyncFrequency  String?
  googleSheetsTokens         Json?
  googleSheetsUrl            String?
  setupProgress              Int?
  whatsappConfigured         Boolean?
  whatsappPhoneVerified      Boolean?
  whatsappVerifyToken        String?
  whatsappWebhookToken       String?
  
  appointments          Appointment[]
  patients              Patient[]
  providers             Provider[]
  appointmentReminders  AppointmentReminder[]
  notificationSettings  NotificationSettings[]
  whatsappMessages      WhatsAppMessage[]
  auditLogs             AuditLog[]
  messageTemplates      MessageTemplate[]
  systemConfig          SystemConfig[]
  users                 User[]

  @@index([slug])
  @@map("organizations")
}

model User {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String       @db.Uuid
  email           String       @unique @db.VarChar(255)
  password_hash   String       @db.VarChar(255)
  first_name      String       @db.VarChar(100)
  last_name       String       @db.VarChar(100)
  phone_number    String?      @db.VarChar(20)
  role            UserRole     @default(STAFF)
  specialization  String?      @db.VarChar(255)
  license_number  String?      @db.VarChar(100)
  is_active       Boolean?     @default(true)
  last_login_at   DateTime?    @db.Timestamptz(6)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)
  password        String?
  phone           String?
  audit_logs      AuditLog[]
  organizations   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email], map: "idx_users_email")
  @@index([organization_id], map: "idx_users_organization_id")
  @@map("users")
}

model Provider {
  id                   String      @id @default(cuid())
  organizationId       String
  firstName            String
  lastName             String
  title                String?
  specialization       String?
  licenseNumber        String?
  email                String?
  phone                String?
  experience           Int?
  qualifications       String?
  biography            String?
  isActive             Boolean     @default(true)
  consultationDuration Int?
  consultationFee      Decimal?    @db.Decimal(10, 2)
  currency             String?
  workingHours         Json?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  
  appointments         Appointment[]
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("providers")
}

model Patient {
  id                     String            @id @default(cuid())
  organizationId         String
  firstName              String
  lastName               String
  phone                  String
  email                  String?
  dateOfBirth            DateTime?
  gender                 Gender?
  address                String?
  city                   String?
  state                  String?
  postalCode             String?
  country                String            @default("Pakistan")
  bloodGroup             BloodGroup?
  allergies              String?
  medicalHistory         String?
  emergencyContact       String?
  whatsappNumber         String?
  preferredLanguage      String            @default("en")
  isActive               Boolean           @default(true)
  registrationSource     RegistrationSource @default(WHATSAPP)
  googleSheetsRowId      String?
  lastSyncedAt           DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  primaryContact         Boolean           @default(true)
  relationToPrimaryContact String?
  
  appointments           Appointment[]
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappMessages       WhatsAppMessage[]

  @@index([organizationId])
  @@map("patients")
}

model Appointment {
  id                   String              @id @default(cuid())
  title                String?
  description          String?
  scheduledAt          DateTime
  duration             Int                 @default(30)
  endTime              DateTime
  status               AppointmentStatus   @default(SCHEDULED)
  priority             AppointmentPriority @default(NORMAL)
  bookingSource        BookingSource       @default(WHATSAPP)
  bookedAt             DateTime            @default(now())
  reminderSent         Boolean             @default(false)
  reminderSentAt       DateTime?
  followUpSent         Boolean             @default(false)
  followUpSentAt       DateTime?
  actualStartTime      DateTime?
  actualEndTime        DateTime?
  consultationNotes    String?
  prescriptions        String?
  nextAppointmentDate  DateTime?
  googleSheetsRowId    String?
  lastSyncedAt         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  organizationId       String
  patientId            String
  providerId           String
  lockToken            String?
  lockedAt             DateTime?
  lockedBy             String?

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient              Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider             Provider              @relation(fields: [providerId], references: [id], onDelete: Cascade)
  whatsappMessages     WhatsAppMessage[]
  appointmentReminders AppointmentReminder[]

  @@index([scheduledAt, providerId])
  @@index([patientId, scheduledAt])
  @@map("appointments")
}

model WhatsAppMessage {
  id                  String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id     String       @db.Uuid
  patient_id          String?      @db.Uuid
  appointment_id      String?      @db.Uuid
  whatsapp_message_id String?      @db.VarChar(255)
  phone_number        String       @db.VarChar(20)
  message_type        message_type
  message_content     String
  template_name       String?      @db.VarChar(255)
  is_incoming         Boolean?     @default(false)
  delivery_status     String?      @default("pending") @db.VarChar(50)
  delivered_at        DateTime?    @db.Timestamptz(6)
  read_at             DateTime?    @db.Timestamptz(6)
  error_message       String?
  created_at          DateTime?    @default(now()) @db.Timestamptz(6)
  appointments        Appointment? @relation(fields: [appointment_id], references: [id], onUpdate: NoAction)
  organizations       Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patients            Patient?     @relation(fields: [patient_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_whatsapp_messages_created_at")
  @@index([organization_id], map: "idx_whatsapp_messages_organization_id")
  @@index([phone_number], map: "idx_whatsapp_messages_phone")
  @@map("whatsapp_messages")
}

model MessageTemplate {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String       @db.Uuid
  name            String       @db.VarChar(255)
  type            message_type
  language        String?      @default("en") @db.VarChar(10)
  subject         String?      @db.VarChar(255)
  content         String
  variables       Json?
  is_active       Boolean?     @default(true)
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @default(now()) @db.Timestamptz(6)
  organizations   Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, name, language])
  @@map("message_templates")
}

model AuditLog {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String?       @db.Uuid
  user_id         String?       @db.Uuid
  table_name      String        @db.VarChar(255)
  record_id       String?       @db.Uuid
  action          String        @db.VarChar(50)
  old_values      Json?
  new_values      Json?
  timestamp       DateTime?     @default(now()) @db.Timestamptz(6)
  ip_address      String?       @db.Inet
  user_agent      String?
  organizations   Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           User?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([organization_id], map: "idx_audit_logs_organization_id")
  @@index([timestamp], map: "idx_audit_logs_timestamp")
  @@map("audit_logs")
}

model SystemConfig {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organization_id String?       @db.Uuid
  config_key      String        @db.VarChar(255)
  config_value    String?
  config_type     String?       @default("string") @db.VarChar(50)
  description     String?
  is_encrypted    Boolean?      @default(false)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)
  organizations   Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organization_id, config_key])
  @@map("system_config")
}

enum appointment_status {
  scheduled
  confirmed
  completed
  cancelled
  no_show
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum BookingSource {
  WHATSAPP
  DASHBOARD
  PHONE
  WALK_IN
  GOOGLE_SHEETS
}

enum message_type {
  appointment_confirmation
  reminder
  follow_up
  custom
}

enum provider_status {
  active
  inactive
  on_leave
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  DOCTOR
  STAFF
  PROVIDER

  @@map("user_role")
}

enum OrganizationType {
  CLINIC
  DOCTOR
  HOSPITAL
  SPECIALIST
  PHARMACY
  DIAGNOSTIC

  @@map("OrganizationType")
}

model TrialHistory {
  id               String    @id @default(cuid())
  phoneNumber      String    @unique
  email            String
  organizationName String
  phoneVerified    Boolean   @default(false)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([organizationName])
  @@map("trial_history")
}

model BillingHistory {
  id              String   @id @default(cuid())
  organizationId  String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String
  paymentMethod   String
  paymentStatus   String
  transactionId   String?
  billingPeriod   String
  doctorCount     Int
  createdAt       DateTime @default(now())

  @@index([organizationId, billingPeriod])
  @@map("billing_history")
}

model AppointmentReminder {
  id             String          @id @default(cuid())
  organizationId String
  appointmentId  String
  reminderType   ReminderType
  trigger        ReminderTrigger @default(AUTOMATIC)
  sentBy         String?
  scheduledFor   DateTime
  sentAt         DateTime?
  status         ReminderStatus  @default(PENDING)
  messageId      String?
  skipReason     String?
  attempts       Int             @default(0)
  lastAttemptAt  DateTime?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([appointmentId, reminderType])
  @@index([trigger])
  @@map("appointment_reminders")
}

model NotificationSettings {
  id                          String         @id @default(cuid())
  organizationId              String         @unique
  language                    String         @default("en")
  bookingConfirmationsEnabled Boolean        @default(true)
  remindersEnabled            Boolean        @default(true)
  followUpsEnabled            Boolean        @default(false)
  medicationRemindersEnabled  Boolean        @default(false)
  wellnessChecksEnabled       Boolean        @default(false)
  reminderTiming              ReminderTiming @default(HOURS_24)
  customReminderMinutes       Int?
  // Follow-up timing configuration (in hours)
  sameDayFollowUpHours        Int            @default(2)  @map("same_day_follow_up_hours") // Hours after completion
  nextDayFollowUpHours        Int            @default(24) @map("next_day_follow_up_hours") // Hours after appointment
  noShowFollowUpHours         Int            @default(1)  @map("no_show_follow_up_hours")  // Hours after no-show detection
  enabledChannels             String[]       @default(["WHATSAPP"])
  quietHoursEnabled           Boolean        @default(false)
  quietHoursStart             String?
  quietHoursEnd               String?
  monthlyCap                  Decimal?       @db.Decimal(10, 2)
  currentMonthSpend           Decimal        @default(0) @db.Decimal(10, 2)
  alertThreshold              Int            @default(80)
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("notification_settings")
}

enum ReminderType {
  REMINDER_24H
  REMINDER_2H
  REMINDER_30MIN
  FOLLOWUP_SAME_DAY
  FOLLOWUP_NEXT_DAY
  NO_SHOW_FOLLOWUP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

enum ReminderTrigger {
  AUTOMATIC
  MANUAL
}

enum ReminderTiming {
  IMMEDIATELY
  MINUTES_30
  HOURS_1
  HOURS_2
  HOURS_4
  HOURS_24
  HOURS_48
  HOURS_72
  CUSTOM
}

enum SubscriptionPlan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum RegistrationSource {
  WHATSAPP
  DASHBOARD
  GOOGLE_SHEETS
  API
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}
