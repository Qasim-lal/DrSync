# DrSync Development Environment Configuration
# Copy this file to .env and update the values as needed

# Project Configuration
PROJECT_NAME=drsync
COMPOSE_PROJECT_NAME=drsync_dev

# Database Configuration
POSTGRES_DB=drsync_dev
POSTGRES_USER=drsync_user
POSTGRES_PASSWORD=drsync_password_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=drsync_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=3001
NODE_ENV=development
JWT_SECRET=dev_jwt_secret_change_in_production

# Frontend Configuration
FRONTEND_PORT=3000
NEXTAUTH_SECRET=dev_nextauth_secret_change_in_production
NEXTAUTH_URL=http://localhost:3000

# PgAdmin Configuration (optional)
PGADMIN_DEFAULT_EMAIL=admin@drsync.dev
PGADMIN_DEFAULT_PASSWORD=pgadmin_password
PGADMIN_PORT=5050

# Development Options
ENABLE_PGADMIN=false
ENABLE_MONITORING=false

# Encryption Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate_a_64_character_hex_string_for_production

# WhatsApp Business API Configuration
# Get these from Meta Business Manager (business.facebook.com)
WHATSAPP_API_VERSION=v18.0
WHATSAPP_APP_SECRET=7583c866de7debbea9d5e4b83bbe974d
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Base URLs
WHATSAPP_BASE_URL=https://graph.facebook.com/v18.0
WEBHOOK_BASE_URL=https://api.drsync.health/v1
