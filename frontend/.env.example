# Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=DrSync
NEXT_PUBLIC_APP_VERSION=1.0.0

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_TIMEOUT=10000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Database URL for NextAuth (optional, using API instead)
# DATABASE_URL=postgresql://drsync_user:drsync_password_dev@localhost:5432/drsync_dev

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false
NEXT_PUBLIC_DEBUG_MODE=true

# External Services
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# PWA Configuration
NEXT_PUBLIC_PWA_NAME=DrSync Dashboard
NEXT_PUBLIC_PWA_SHORT_NAME=DrSync
NEXT_PUBLIC_PWA_DESCRIPTION=Healthcare Appointment Management Dashboard

# Theme Configuration
NEXT_PUBLIC_DEFAULT_THEME=light
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# Monitoring and Analytics
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id_here

# Development Tools
NEXT_PUBLIC_SHOW_LOGGER=true
ANALYZE=false
